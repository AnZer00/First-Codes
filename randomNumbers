const numbers = [];

for (let i = 0; i < 100; i++) {
	const randomNumber = Math.floor(Math.random() * 1000);
	numbers.push(randomNumber);
	process.stdout.write("" + randomNumber + " ");

	if ((i + 1) % 10 === 0) {
		process.stdout.write("\n");
	}
}

for (let largest = 0; largest < numbers.length; largest++) {
    if (numbers[largest] > numbers[0]) {
        numbers[0] = numbers[largest];
    }
    console.log(`Largest number: ${numbers[0]}`);
}

